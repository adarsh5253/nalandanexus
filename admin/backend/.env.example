# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5003
CLIENT_URL=http://localhost:5175
SERVER_URL=http://localhost:5003

# ── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas (preferred in production) or local MongoDB instance.
# Database name is part of the URI path (defaults to "nalanda_admin" if omitted).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/nalanda_admin?appName=<appName>


# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_NAME=nalanda_admin_token

# ── Security ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Seed (development only) ─────────────────────────────────────────────
SEED_SUPER_ADMIN_NAME=Adarsh Admin
SEED_SUPER_ADMIN_EMAIL=admin@nalanda.edu
SEED_SUPER_ADMIN_PASSWORD=Admin@Nalanda2026!

# ── Cross-portal bridge (student backend) ───────────────────────────────
# Lets an ALL/STUDENTS-audience announcement actually reach the student
# portal — a separate service/database with no shared user identity, so
# this uses a shared secret rather than a session. Must match
# INTERNAL_SERVICE_KEY in student/backend/.env exactly. Leave
# STUDENT_BACKEND_URL blank to disable the bridge entirely (announcements
# still work within the admin portal alone).
STUDENT_BACKEND_URL=http://localhost:5001
STUDENT_BACKEND_SERVICE_KEY=replace_with_the_same_value_as_student_backend_INTERNAL_SERVICE_KEY

# ── Cross-portal bridge (teacher backend) ───────────────────────────────
# Provisions a real Teacher Portal login when Admin creates a teacher (see
# services/teacherBridge.service.js). Must match STUDENT_BACKEND_SERVICE_KEY
# in teacher/backend/.env exactly. Leave TEACHER_BACKEND_URL blank to
# disable the bridge (teacher creation still writes admin's own governance
# record, but the teacher won't be able to log into the Teacher Portal).
TEACHER_BACKEND_URL=http://localhost:5002
TEACHER_BACKEND_SERVICE_KEY=replace_with_the_same_value_as_teacher_backend_STUDENT_BACKEND_SERVICE_KEY

# ── Email (optional - if unset, emails are logged to console instead of sent) ──
# Sent via SendGrid's HTTPS API, not SMTP - Render blocks outbound SMTP ports
# (25/465/587) on free-tier web services, so raw SMTP can never work there
# regardless of credentials. Get a key at https://app.sendgrid.com/settings/api_keys
# after verifying the sender address below under Settings > Sender Authentication
# > Single Sender Verification (no domain/DNS ownership required).
SENDGRID_API_KEY=
SMTP_FROM="Nalanda Nexus <nalandanexus@gmail.com>"
# The From address MUST be a verified sender in SendGrid, or every send is
# rejected (HTTP 403 "from address does not match a verified Sender Identity").
# That reason is recorded on each teacher and shown in the Admin portal.
# Prefer an address on a domain you own and have authenticated in SendGrid: mail
# claiming to be from a free @gmail.com address is often dropped by receivers.

# ── Teacher onboarding ───────────────────────────────────────────────────
# New teachers get an email with a single-use link to choose their own password
# (no password is ever sent). Both settings below are optional.
#
# Where teachers sign in. Leave UNSET: the Teacher service reports its own
# frontend address (its CLIENT_URL) when it creates the login, and the email
# links there. Set it only to override that with a custom domain.
# TEACHER_PORTAL_URL=https://teacher.example.com
#
# How long the setup link works, in hours (1-168). Default 72.
# TEACHER_SETUP_LINK_TTL_HOURS=72
