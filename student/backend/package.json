  "description": "Nalanda Nexus - Student Portal API Service (Express + MongoDB + Razorpay)",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
